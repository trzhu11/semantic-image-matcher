# Copy this file to .env.local and fill in the deployment-specific values.

# Runtime
CONDA_PYTHON=/home/test/.conda/envs/semantic_matcher/bin/python
QWEN_BACKEND_BASE_URL=http://127.0.0.1:18080
QWEN_BACKEND_MODEL=qwen3-vl-8b-instruct-q8_0
QWEN_PUBLIC_MODEL_VERSION=Qwen3-VL-8B-Instruct

# Models
QWEN_GGUF_MODEL_PATH=/share/shared_weights/Qwen3-VL-8B-Instruct-GGUF/Qwen3VL-8B-Instruct-Q8_0.gguf
QWEN_GGUF_MMPROJ_PATH=/share/shared_weights/Qwen3-VL-8B-Instruct-GGUF/mmproj-Qwen3VL-8B-Instruct-Q8_0.gguf
DINO_MODEL_PATH=/share/shared_weights/dinov3/facebook/dinov3-vith16plus-pretrain-lvd1689m
VECTOR_DIM=1280
VECTOR_ES_INDEX=intour_vector_store
VECTOR_SIMILARITY=cosine

# Elasticsearch
ES_HOST=https://your-es-host:9200
ES_USER=elastic
ES_PASS=replace-with-real-password
ES_CERT=/path/to/http.pem
ES_VERIFY_CERTS=1

# Image download / rewrite
IMAGE_URL_REWRITE_FROM=https://your-public-image-prefix/
IMAGE_URL_REWRITE_TO=http://your-lan-image-host:9000/
IMAGE_FORCE_DIRECT_HOSTS=127.0.0.1,localhost
IMAGE_HTTP_TRUST_ENV=0

# GPUs
CUDA_DEVICE=0

# Optional split-GPU mode
BACKEND_CUDA_DEVICE=0
SERVICE_CUDA_DEVICE=0
DINO_DEVICE=cuda:0
VECTOR_DEVICE=cuda:0
